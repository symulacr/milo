{
  "name": "milo",
  "version": "0.0.3",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "setup:native-node": "sh scripts/with-bun.sh scripts/setup-native-node.ts",
    "setup:native-network": "sh scripts/with-bun.sh scripts/setup-native-node.ts && python3 scripts/setup-native-services.py",
    "setup:integration-runtime": "sh scripts/with-bun.sh scripts/setup-integration-runtime.ts",
    "setup": "sh scripts/setup.sh",
    "contract:cohort": "sh scripts/with-bun.sh scripts/verify-compact-cohort.ts",
    "contract:compile": "sh scripts/with-bun.sh scripts/compile-contract.ts",
    "research:developer": "sh scripts/with-bun.sh node_modules/firecrawl-cli/dist/index.js developer",
    "dev": "sh scripts/with-bun.sh --hot scripts/dev.ts",
    "build": "sh scripts/with-bun.sh scripts/build.ts",
    "typecheck": "sh scripts/with-bun.sh node_modules/typescript/bin/tsc --noEmit",
    "check:plan": "sh scripts/with-bun.sh scripts/check-plan.ts",
    "lint": "sh scripts/with-bun.sh node_modules/@biomejs/biome/bin/biome check .",
    "test:unit": "sh scripts/with-bun.sh test --parallel apps/web packages/domain packages/contract packages/backend packages/midnight-client convex e2e scripts/*.test.ts",
    "ship": "bash scripts/post-push-verify.sh",
    "ship:release": "bash scripts/post-push-verify.sh --release",
    "ship:force": "bash scripts/post-push-verify.sh --force",
    "ci": "bash scripts/post-push-verify.sh --ci",
    "test:integration": "sh scripts/with-bun.sh scripts/test-integration.ts",
    "test:native-network": "sh scripts/with-bun.sh scripts/setup-native-node.ts && python3 scripts/setup-native-services.py && sh scripts/with-bun.sh scripts/test-native-network.ts",
    "test:native-node": "sh scripts/with-bun.sh scripts/test-native-network.ts"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.12.5",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/ledger-v8": "8.1.3",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/onchain-runtime-v3": "3.1.2",
    "@midnight-ntwrk/zkir-v2": "2.1.1",
    "@noble/hashes": "2.4.0",
    "better-auth": "1.6.33",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "convex": "1.47.0",
    "framer-motion": "14.7.1",
    "motion": "14.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "stripe": "23.0.1",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "@midnight-ntwrk/ledger-v8": "$@midnight-ntwrk/ledger-v8",
    "@midnight-ntwrk/onchain-runtime-v3": "$@midnight-ntwrk/onchain-runtime-v3",
    "@midnight-ntwrk/zkir-v2": "$@midnight-ntwrk/zkir-v2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "axe-core": "4.14.0",
    "bun-plugin-tailwind": "0.1.2",
    "happy-dom": "21.0.4",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24 <27"
  }
}
