{
  "name": "milo",
  "version": "0.0.3",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "setup:native-node": "sh scripts/with-bun.sh scripts/setup-native-node.ts",
    "setup:native-network": "sh scripts/with-bun.sh scripts/setup-native-node.ts && python3 scripts/setup-native-services.py",
    "setup:integration-runtime": "sh scripts/with-bun.sh scripts/setup-integration-runtime.ts",
    "setup": "sh scripts/setup.sh",
    "contract:cohort": "sh scripts/with-bun.sh scripts/verify-compact-cohort.ts",
    "contract:compile": "sh scripts/with-bun.sh scripts/compile-contract.ts",
    "research:developer": "sh scripts/with-bun.sh node_modules/firecrawl-cli/dist/index.js developer",
    "dev": "sh scripts/with-bun.sh --hot scripts/dev.ts",
    "build": "sh scripts/with-bun.sh scripts/build.ts",
    "typecheck": "sh scripts/with-bun.sh node_modules/typescript/bin/tsc --noEmit",
    "check:plan": "sh scripts/with-bun.sh scripts/check-plan.ts",
    "lint": "sh scripts/with-bun.sh node_modules/@biomejs/biome/bin/biome check .",
    "test:unit": "sh scripts/with-bun.sh test apps/web packages/domain packages/contract packages/backend scripts",
    "test:integration": "sh scripts/with-bun.sh scripts/test-integration.ts",
    "test:native-network": "sh scripts/with-bun.sh scripts/setup-native-node.ts && python3 scripts/setup-native-services.py && sh scripts/with-bun.sh scripts/test-native-network.ts",
    "test:native-node": "sh scripts/with-bun.sh scripts/test-native-network.ts"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.12.5",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/onchain-runtime-v3": "3.1.2",
    "@noble/hashes": "2.4.0",
    "better-auth": "1.6",
    "convex": "1.47.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "stripe": "23.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "happy-dom": "21.0.1",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "26.11.1"
  }
}
