# Allowlist ignore file: ignore everything, then re-include what ships.
# `*` does not match dotfiles, so those are named explicitly, and a directory
# must be re-included before its contents (`!/dir/` then `!/dir/**`).
*

# Root files
!/.gitignore
!/.env.example
!/LICENSE
!/README.md
!/RUNBOOKS.md
!/SECURITY.md
!/CONTRIBUTING.md
!/THIRD_PARTY_NOTICES.md
!/package.json
!/tsconfig.json
!/biome.json
!/bun.lock
!/bunfig.toml
!/components.json

# Source, docs and CI
!/.github/
!/.github/**
!/apps/
!/apps/**
!/convex/
!/convex/**
!/docs/
!/docs/ARCHITECTURE.md
!/docs/MIDNIGHT-INTEGRATION.md
!/docs/PROVENANCE.md
!/docs/RECEIPTS.md
!/docs/adr/
!/docs/adr/**
!/docs/audit/
!/docs/audit/**
!/docs/media/
!/docs/media/**
!/docs/plan/
!/docs/plan/**
!/e2e/
!/e2e/**
!/evidence/
!/evidence/**
!/infra/
!/infra/**
!/legal/
!/legal/**
!/packages/
!/packages/**
!/scripts/
!/scripts/**

# Dependencies, build output, generated code, local state and secrets
node_modules
dist/
build/
coverage/
test-results/
playwright-report/
__pycache__/
.convex/
.hoplite/
.tools/
.vercel/
.scratch/
hardening/
midnight-level-db/
packages/contract/generated/
apps/web/public/qa-build/
apps/web/artwork/
e2e/**/out/
*.log
*.diff
*.pem
*.tgz
*.webm
*Zone.Identifier
.DS_Store
.env
.env.*
!/.env.example

# Local-only tooling, scratch and campaign notes. They stay on disk for local
# work; none is needed to build, test or run the shipped app.
# check.yml repeats local-checks.yml and adds test:native-network, which needs
# local Midnight services, so it would fail on a hosted runner.
/.github/workflows/check.yml
# `judging-minimum.sh` and `gates/` are NOT local-only: `scripts/post-push-verify.sh`
# runs the former, so ignoring it made `bun run ship` fail on every machine but
# the one that wrote it. Both ship now.
/apps/web/public/_redirects
/apps/web/public/watch.html
/apps/web/public/qa-*
/apps/web/src/qa-reserve-ui.tsx
/e2e/flows/debug-*.mjs
/e2e/flows/*-result.json
/packages/integration/src/p0-*.mjs
/packages/integration/src/d2c-split.mjs
/packages/integration/src/verify-persisted-constructor.mjs
/packages/midnight-client/scripts/
/scripts/convex-local-*
!/scripts/convex-local-lifecycle-check.py
/scripts/g4-negative-controls.sh
/scripts/m11-verify*.mjs
/scripts/master-ledger-rebuild.sh
/scripts/net-health.sh
/scripts/next-task.sh
/scripts/ownership-check.sh
/scripts/pr7-axe*.mjs
/scripts/preprod-observe.mjs
/scripts/privy-test-login*.ts
/scripts/spend-balance.mjs
/scripts/todo-check.sh
/scripts/todo_lib.py

# Deployment artifacts. The stress image and its Render blueprint are how the
# volume run is executed on a host with enough RAM, so they ship with the code
# they describe. The build inputs they COPY (the prover, its params, the compiled
# contract) stay ignored: they are large binaries, and the Dockerfile fails with a
# named error rather than producing an image that cannot prove.
!/.dockerignore
!/render.yaml
!/deploy/
!/deploy/**
/deploy/stress/Dockerfile.*
/deploy/stress/entrypoint.mjs
