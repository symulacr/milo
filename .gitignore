# Allowlist ignore file: ignore everything, then re-include what ships.
# `*` does not match dotfiles, so those are named explicitly, and a directory
# must be re-included before its contents (`!/dir/` then `!/dir/**`).
*

# Root files
!/.gitignore
!/.env.example
!/LICENSE
!/README.md
!/SUBMISSION-UPDATE.md
!/THIRD_PARTY_NOTICES.md
!/package.json
!/tsconfig.json
!/biome.json
!/bun.lock

# Source, docs and CI
!/.github/
!/.github/**
!/apps/
!/apps/**
!/convex/
!/convex/**
!/docs/
!/docs/MIDNIGHT-INTEGRATION.md
!/docs/RECEIPTS.md
!/docs/media/
!/docs/media/**
!/docs/plan/
!/docs/plan/**
!/e2e/
!/e2e/**
!/evidence/
!/evidence/**
!/infra/
!/infra/**
!/legal/
!/legal/**
!/packages/
!/packages/**
!/scripts/
!/scripts/**

# Dependencies, build output, generated code, local state and secrets
node_modules
dist/
build/
coverage/
test-results/
playwright-report/
__pycache__/
.convex/
.hoplite/
.tools/
.vercel/
.scratch/
hardening/
midnight-level-db/
convex/_generated/
packages/contract/generated/
apps/web/public/qa-build/
apps/web/artwork/
e2e/**/out/
*.log
*.diff
*.pem
*.tgz
*.webm
*Zone.Identifier
.DS_Store
.env
.env.*
!/.env.example

# Local-only tooling, scratch and campaign notes. They stay on disk for local
# work; none is needed to build, test or run the shipped app.
# check.yml repeats local-checks.yml and adds test:native-network, which needs
# local Midnight services.
/.github/workflows/check.yml
/apps/web/public/_redirects
/apps/web/public/watch.html
/apps/web/public/qa-*
/apps/web/src/qa-reserve-ui.tsx
/e2e/flows/debug-*.mjs
/e2e/flows/*-result.json
/packages/integration/src/p0-*.mjs
/packages/integration/src/d2c-split.mjs
/packages/integration/src/verify-persisted-constructor.mjs
/packages/midnight-client/scripts/
/scripts/convex-local-*
!/scripts/convex-local-lifecycle-check.py
/scripts/gates/
/scripts/g4-negative-controls.sh
/scripts/judging-minimum.sh
/scripts/m11-verify*.mjs
/scripts/master-ledger-rebuild.sh
/scripts/net-health.sh
/scripts/next-task.sh
/scripts/ownership-check.sh
/scripts/post-push-verify.sh
/scripts/pr7-axe*.mjs
/scripts/preprod-observe.mjs
/scripts/privy-test-login*.ts
/scripts/spend-balance.mjs
/scripts/todo-check.sh
/scripts/todo_lib.py

# Verification gates and their evidence are tracked, so a fresh clone can
# re-run every "done" claim instead of taking it on trust. The exclusions
# above predate the gate suite; these re-includes supersede them.
!/scripts/gates/
!/scripts/gates/**
!/scripts/g4-negative-controls.sh
!/scripts/judging-minimum.sh
!/scripts/m11-verify.mjs
!/scripts/m11-verify-all.mjs
!/scripts/post-push-verify.sh
!/scripts/pr7-axe.mjs
!/scripts/pr7-axe-all.mjs

# Durable audit evidence: the markdown reports and gate-result JSON that the
# gates read by path. Run logs, screenshots and test output stay local.
!/audit/
!/audit/discovery/
!/audit/discovery/*.md
!/audit/discovery/*.json
/audit/discovery/_g4_logs/
/audit/discovery/*.png
/audit/discovery/*.log
/audit/discovery/*.out
