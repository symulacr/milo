# Allowlist ignore file: ignore everything, then re-include what ships.
# `*` does not match dotfiles, so those are named explicitly, and a directory
# must be re-included before its contents (`!/dir/` then `!/dir/**`).
*

# Root files
!/.gitignore
!/.env.example
!/LICENSE
!/README.md
!/RUNBOOKS.md
!/SECURITY.md
!/CONTRIBUTING.md
!/THIRD_PARTY_NOTICES.md
!/package.json
!/tsconfig.json
!/biome.json
!/bun.lock
!/bunfig.toml
!/components.json

# Source, docs and CI
!/.github/
!/.github/**
!/apps/
!/apps/**
!/convex/
!/convex/**
# `docs/` ships whole. The allowlist that used to live here named four files and
# four directories, so twenty real documents existed only on the machine that
# wrote them. A list that rots silently is worse than no list. Scratch goes in
# `docs/scratch/`, which stays ignored.
!/docs/
!/docs/**
/docs/scratch/
# `pitch/` is a judged deliverable: judging-minimum.sh J4 reads
# pitch/deck/milo-d7-deck.pdf, so an untracked pitch/ makes that gate fail on
# every clone.
!/pitch/
/pitch/*
!/pitch/deck/
!/pitch/deck/**
!/e2e/
!/e2e/**
!/evidence/
!/evidence/**
!/infra/
!/infra/**
!/wrangler.toml
!/legal/
!/legal/**
!/packages/
!/packages/**
!/scripts/
!/scripts/**

# Dependencies, build output, generated code, local state and secrets
node_modules
dist/
build/
coverage/
test-results/
playwright-report/
__pycache__/
.convex/
.hoplite/
.tools/
.vercel/
.scratch/
hardening/
midnight-level-db/
packages/contract/generated/
apps/web/public/qa-build/
apps/web/artwork/
e2e/**/out/
*.log
*.diff
*.pem
*.tgz
*.webm
# The showreel is a judged deliverable; the generic rule above would hide it.
!/pitch/showreel/video/*.webm
*Zone.Identifier
.DS_Store
.env
.env.*
!/.env.example

# Local-only tooling, scratch and campaign notes. They stay on disk for local
# work; none is needed to build, test or run the shipped app.
# check.yml repeats local-checks.yml and adds test:native-network. It is a
# duplicate lane, not an unrunnable one: the native path needs no container
# runtime (setup-native-services.py extracts pinned binaries from the registry)
# and this repo is public, so runner minutes are free and unlimited. Ignored
# because it is redundant, and untracked files must not look authoritative.
/.github/workflows/check.yml
# `judging-minimum.sh` and `gates/` are NOT local-only: `scripts/post-push-verify.sh`
# runs the former, so ignoring it made `bun run ship` fail on every machine but
# the one that wrote it. Both ship now.
/apps/web/public/watch.html
/apps/web/public/qa-*
/apps/web/src/qa-reserve-ui.tsx
/e2e/flows/debug-*.mjs
/e2e/flows/*-result.json
/packages/integration/src/p0-*.mjs
/packages/integration/src/d2c-split.mjs
/packages/integration/src/verify-persisted-constructor.mjs
/packages/midnight-client/scripts/
/scripts/convex-local-*
!/scripts/convex-local-lifecycle-check.py
/scripts/g4-negative-controls.sh
/scripts/m11-verify*.mjs
/scripts/master-ledger-rebuild.sh
/scripts/net-health.sh
/scripts/next-task.sh
/scripts/ownership-check.sh
/scripts/pr7-axe*.mjs
/scripts/preprod-observe.mjs
/scripts/privy-test-login*.ts
/scripts/spend-balance.mjs
/scripts/todo-check.sh
/scripts/todo_lib.py

# Deployment artifacts. The stress image and its Render blueprint are how the
# volume run is executed on a host with enough RAM, so they ship with the code
# they describe. The build inputs they COPY (the prover, its params, the compiled
# contract) stay ignored: they are large binaries, and the Dockerfile fails with a
# named error rather than producing an image that cannot prove.
!/.dockerignore
!/render.yaml
!/deploy/
!/deploy/**
/deploy/stress/Dockerfile.*
/deploy/stress/entrypoint.mjs

# Dead sample images: no tracked code references them. They stay on disk and
# still ship in dist/ (build.ts globs apps/web/public), but the repo should not
# carry 220 KiB of unreferenced duplicates.
/apps/web/public/samples/

# Unreferenced design stills: the seven images the app actually uses live in
# apps/web/src/assets.ts and InfoPage.tsx; these remain ignored. packing /
# proof-review / shoot are used by field-canvas + StageGallery and stay tracked.
/apps/web/public/images/sc-*.webp

# Local QA captures and verify dumps — not ship artifacts.
/evidence/qa-*.png
/evidence/reel-verified/

# Derived deck output. _build_deck.sh regenerates every slide from the tracked
# SVGs with rsvg-convert + pdfunite, and the result is nondeterministic (cairo
# stamps a CreationDate), so these can never diff cleanly. The merged deck
# milo-d7-deck.pdf stays tracked: judging-minimum.sh J4 reads it.
/pitch/deck/slide-*.pdf
