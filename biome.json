{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "scripts/**",
      "convex/**",
      "*.json",
      "!packages/contract/generated",
      "!convex/_generated",
      "!scripts/gates/*.json",
      "!gates"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "overrides": [
    {
      "includes": ["apps/web/src/components/ui/input.tsx"],
      "linter": { "rules": { "a11y": { "noLabelWithoutControl": "off" } } }
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["Input", "NativeSelect", "Textarea"]
          }
        }
      }
    }
  }
}
