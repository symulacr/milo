BETTER_AUTH_URL=
CONVEX_URL=
MIDNIGHT_NETWORK=preprod
STRIPE_PUBLISHABLE_KEY=

BETTER_AUTH_SECRET=
SITE_URL=
# Who receives the daily dead-letter digest (convex/diagnostics.ts). Comma
# separated. When this is unset the digest silently no-ops, so an unset value
# looks identical to "nothing is wrong". Set it in every environment.
MILO_OPERATOR_EMAILS=
# Which mail provider sends the magic link: resend | agentmail | brevo.
# Defaults to resend, so nothing changes until this is set.
MAIL_PROVIDER=
# The key for the selected provider. Set only the one you use.
RESEND_API_KEY=
AGENTMAIL_API_KEY=
BREVO_API_KEY=
MAIL_FROM=
# Where the provider's send endpoint lives. Leave unset for the real API. Point it
# at a local capture server (e.g. http://127.0.0.1:8025/api/v1 for Mailpit) to read
# the magic link in a test without a provider account or a verified domain.
# MAIL_BASE_URL applies to any provider; RESEND_BASE_URL is the Resend-only
# original and still works (MAIL_BASE_URL wins when both are set).
MAIL_BASE_URL=
RESEND_BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
MIDNIGHT_PREPROD_INDEXER_HTTP=https://midnight-preprod.blockfrost.io/api/v0
# Alias for the line above; the chain observer accepts either name.
MILO_PREPROD_INDEXER_HTTP=
MILO_PREPROD_BLOCKFROST_PROJECT_ID=
MILO_TRUSTED_PROVISIONING_AUTHORITIES=
MILO_OPERATOR_EMAILS=
MILO_OPERATOR_SECRET=

MILO_PREPROD_ALLOW=
MILO_PREPROD_NETWORK_ID=preprod
MILO_PREPROD_GENESIS_HASH=
MILO_PREPROD_MODE=observe
MILO_PREPROD_PROOF_HTTP=http://127.0.0.1:6300
MIDNIGHT_PREPROD_SEED=
