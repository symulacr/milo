# Every environment variable read in tracked source.
#
# The authoritative machine-readable definition is
# packages/backend/src/public-config.ts `serverEnvSchema`. This file documents
# each name, its type and whether it is safe to expose to a browser.
# Empty value = unset. Values are NEVER read from .env.local or .env.preprod
# by any tooling, and must never be committed.

# ---------------------------------------------------------------------------
# Browser-safe. Served only through /api/public-config, never inlined.
# ---------------------------------------------------------------------------
# string, public. Privy application id; also the Convex customJwt audience.
PRIVY_APP_ID=
# url, public. Must be https://<deployment>.convex.cloud with no path,
# credentials, query or fragment.
CONVEX_URL=
# literal "preprod", public. Only Midnight preprod is enabled.
MIDNIGHT_NETWORK=preprod

# ---------------------------------------------------------------------------
# Server secrets. Convex deployment environment or the operator shell only.
# Never browser-safe, never logged, never returned by /api/public-config.
# ---------------------------------------------------------------------------
# string, secret. Privy app secret; signs operator-issued test tokens.
PRIVY_APP_SECRET=
# string, secret. Stripe test-mode secret key.
STRIPE_SECRET_KEY=
# string, secret. Stripe webhook endpoint secret. Must match /^whsec_[a-zA-Z0-9]+$/;
# the webhook ingress fails closed when it is absent or malformed.
STRIPE_WEBHOOK_SECRET=
# string, server-only. Stripe connected account id the webhook checks.
# Defaults to "test" when unset.
STRIPE_ACCOUNT_ID=
# comma-separated list, server-only. The operator allowlist that gates every
# trusted-provisioning write (convex/trustedProvisioning.ts and
# packages/backend/src/stripe-customer-provisioning.server.ts).
# UNSET MEANS NOBODY MAY PROVISION.
MILO_TRUSTED_PROVISIONING_AUTHORITIES=

# ---------------------------------------------------------------------------
# Preprod / integration lane. Operator scripts and packages/integration only.
# Never read by a browser, by the webhook ingress, or by public-config.
# ---------------------------------------------------------------------------
# string. Observe (default), deployment-preflight, or deploy.
MILO_PREPROD_MODE=
# string. Midnight network id for the preprod lane.
MILO_PREPROD_NETWORK_ID=
# string, 64-hex. Expected genesis hash the preprod lane verifies against.
MILO_PREPROD_GENESIS_HASH=
# string. Operator acknowledgement to permit preprod effects.
MILO_PREPROD_ALLOW=
# string. Operator acknowledgement to permit the deployment preflight.
MILO_PREPROD_ALLOW_PREFLIGHT=
# url. Owned trusted local proof server; receives private proving inputs.
MILO_PREPROD_PROOF_HTTP=
# string. Expected Midnight runtime specification version.
MILO_PREPROD_RUNTIME_SPEC_VERSION=
# string, 64-hex. Expected 60-file generated artifact-set digest.
MILO_PREPROD_ARTIFACT_SET_SHA256=
# string, 64-hex. Expected compile-receipt digest.
MILO_PREPROD_COMPILE_RECEIPT_SHA256=
# string. Local-lane network id.
MILO_LOCAL_NETWORK_ID=
# string, 64-hex. Local-lane genesis hash.
MILO_LOCAL_GENESIS_HASH=
# positive integer ms. Local step timeout. Default 60000.
MILO_LOCAL_TIMEOUT_MS=
# string. Local bootstrap diagnostic mode.
MILO_LOCAL_BOOTSTRAP_MODE=
# string. Retained-key negative maintenance audit switch.
MILO_LOCAL_MAINTENANCE_AUDIT=
# string. Crash-and-restore recovery audit switch.
MILO_LOCAL_RECOVERY_AUDIT=
# string. Local transaction-submission switch; off unless set.
MILO_LOCAL_ALLOW_TRANSACTIONS=
# positive integer ms. Watchdog for awaited proofs. Default 900000.
MILO_AWAIT_TIMEOUT_MS=
# path. Circuit-sweep run directory.
MILO_SWEEP_RUN_DIR=
# path. Circuit-sweep JSONL receipt trail.
MILO_SWEEP_TRAIL=
# string. Restrict a sweep to read-only reporting.
MILO_SWEEP_ONLY=
# string. Fee spin reproduction switch.
MILO_FEE_REPRO=
# url. Midnight node endpoint for the preprod lane.
MIDNIGHT_PREPROD_NODE=
# string, secret. Midnight wallet seed for the preprod lane. NEVER commit.
MIDNIGHT_PREPROD_SEED=
# path. Preprod-lane run directory.
MIDNIGHT_PREPROD_RUN_DIR=
# string. Shielded preprod operator address.
MIDNIGHT_PREPROD_ADDRESS=
# string. Shielded preprod DUST address.
MIDNIGHT_PREPROD_DUST_ADDRESS=
# url. Owned trusted local proof server for the Midnight lane.
MIDNIGHT_PREPROD_PROOF_HTTP=
# url. Midnight indexer HTTP endpoint.
MIDNIGHT_PREPROD_INDEXER_HTTP=
# url. Midnight indexer websocket endpoint.
MIDNIGHT_PREPROD_INDEXER_WS=
# positive integer ms. Preprod progress reporting interval. Default 15000.
MIDNIGHT_PREPROD_PROGRESS_INTERVAL_MS=

# ---------------------------------------------------------------------------
# Operator test fixtures for scripts/privy-test-login.ts.
# ---------------------------------------------------------------------------
# string. Synthetic test email; never a real customer address.
PRIVY_TEST_EMAIL=
# string. Synthetic test phone in E.164; never a real customer number.
PRIVY_TEST_PHONE=